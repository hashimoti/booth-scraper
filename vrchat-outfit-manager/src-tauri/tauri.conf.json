{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRC-Outfit-manager",
  "version": "0.2.0",
  "identifier": "com.vrchat.outfitmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VRC-Outfit-manager",
        "width": 1000,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://*.booth.pm https://*.pixiv.net data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "hashijun"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hashimoti/booth-scraper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzNzg1QjJBOTMzRDhFQjkKUldTNWpqMlRLbHQ0OCt1ckxFeXlxZnZWR1VTL2hrSjlGcGU5MEhLTGtRUzRXMWl2UUlSd2RHVXAK"
    }
  }
}