{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRC-Outfit-Snap",
  "version": "0.1.0",
  "identifier": "com.vrchat.outfitmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VRC Outfit Snap",
        "width": 1000,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "JunHashimoto"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hashimoti/booth-scraper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDODkyQzEwRjQzODI5N0EKUldSNktUajBFQ3lKYkxWYnRWNkxFT2QyU1dveHFhM1hyQ21Od2E0MTFWTm9iQlFkdXFTN2gzVUgK"
    }
  }
}